#!/usr/bin/env bash
# dim-overlay-on — if overlay is off, turn it on; if on, make it darker.
# Three-tier stepping: coarse (default), fine (above fineStepThreshold),
# ultra (above ultraStepThreshold). Snaps to thresholds when crossing them.
# Toggles KDE Night Light off when opacity reaches NL_THRESHOLD.
set -eu

PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/dim-overlay.pid"
LEVEL_FILE="${XDG_RUNTIME_DIR:-/tmp}/dim-overlay.level"
NL_FLAG_FILE="${XDG_RUNTIME_DIR:-/tmp}/dim-overlay.nightlight-toggled"
PY_FILE="@PY_FILE@"

NL_THRESHOLD="0.99"

read_const() {
    awk -F'=' -v k="$1" '$1 ~ "^"k {gsub(/[ \t]/,"",$2); print $2; exit}' "$PY_FILE" 2>/dev/null
}
DEF=$(read_const    "OPACITY_DEF");             [[ -z "$DEF"    ]] && DEF="0.40"
STEP=$(read_const   "OPACITY_STEP");            [[ -z "$STEP"   ]] && STEP="0.05"
FINE=$(read_const   "OPACITY_FINE_STEP");       [[ -z "$FINE"   ]] && FINE="0.02"
THRES=$(read_const  "OPACITY_FINE_THRESHOLD");  [[ -z "$THRES"  ]] && THRES="0.90"
ULTRA=$(read_const  "OPACITY_ULTRA_STEP");      [[ -z "$ULTRA"  ]] && ULTRA="0.01"
UTHRES=$(read_const "OPACITY_ULTRA_THRESHOLD"); [[ -z "$UTHRES" ]] && UTHRES="0.96"
MAX=$(read_const    "OPACITY_MAX");             [[ -z "$MAX"    ]] && MAX="0.95"

nightlight_is_running() {
    local r
    r=$(qdbus org.kde.KWin /org/kde/KWin/NightLight \
              org.freedesktop.DBus.Properties.Get \
              org.kde.KWin.NightLight running 2>/dev/null || echo "false")
    [[ "$r" == "true" ]]
}

nightlight_toggle() {
    dbus-send --session --type=method_call \
        --dest=org.kde.kglobalaccel /component/kwin \
        org.kde.kglobalaccel.Component.invokeShortcut \
        string:"Toggle Night Color" 2>/dev/null || true
}

nightlight_off_if_needed() {
    [[ -f "$NL_FLAG_FILE" ]] && return 0
    if nightlight_is_running; then
        nightlight_toggle
        : > "$NL_FLAG_FILE"
    fi
}

at_or_above_nl_threshold() {
    awk -v c="$1" -v t="$NL_THRESHOLD" 'BEGIN { exit !(c >= t - 0.001) }'
}

PIDS=""
if [[ -f "$PID_FILE" ]]; then
    P=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "$P" ]] && kill -0 "$P" 2>/dev/null; then
        PIDS="$P"
    fi
fi
[[ -z "$PIDS" ]] && PIDS=$(pgrep -f "dim-overlay\.py" || true)

if [[ -n "$PIDS" ]]; then
    kill -USR1 $PIDS
    CUR=$( [[ -f "$LEVEL_FILE" ]] && cat "$LEVEL_FILE" || echo "$DEF" )
    NEW=$(awk -v c="$CUR" -v s="$STEP" -v fs="$FINE" -v us="$ULTRA" \
              -v ft="$THRES" -v ut="$UTHRES" -v m="$MAX" 'BEGIN {
        if      (c >= ut - 0.001) step = us
        else if (c >= ft - 0.001) step = fs
        else                      step = s
        v = c + step
        # Snap to whichever threshold we crossed going up
        if      (c < ft - 0.001 && v > ft + 0.001) v = ft
        else if (c < ut - 0.001 && v > ut + 0.001) v = ut
        if (v > m) v = m
        printf "%.2f", v
    }')
    echo "$NEW" > "$LEVEL_FILE"

    if at_or_above_nl_threshold "$NEW"; then
        nightlight_off_if_needed
    fi
else
    rm -f "$NL_FLAG_FILE"
    setsid nohup "@DIM_OVERLAY@" >/dev/null 2>&1 </dev/null &
    echo "$DEF" > "$LEVEL_FILE"

    if at_or_above_nl_threshold "$DEF"; then
        nightlight_off_if_needed
    fi
fi
