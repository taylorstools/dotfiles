# Minimal Plymouth theme: a bordered passphrase field with the nf-fa-lock
# padlock glyph inset at its right edge, and a pulsing spinner the rest of
# the time.
#
# The prompt string systemd-cryptsetup sends ("Please enter passphrase for
# disk cryptroot...") arrives as the first argument to display_password and is
# deliberately discarded. A script-plugin theme draws every pixel itself, so
# there is no keyboard-layout indicator either unless one is drawn here.
#
# Plymouth's script language has no drawing primitives -- it only composites
# images -- so the field, padlock and spinner frames are pre-rendered PNGs.
# They are used at their natural size and never passed through Image.Scale():
# Plymouth's resampler does not antialias, so scaling a curved 2px border at
# runtime is what made the pill's corners look jagged. Every asset is instead
# rasterised at its final size by rsvg-convert, which does antialias. Size the
# theme through package.nix.
#
# EVERY sprite is created at global scope, below, and shown or hidden with
# SetOpacity afterwards. Nothing creates a sprite inside a callback. A sprite
# assigned to a variable that only ever exists inside a function is local to
# that call and is collected the moment the function returns, so it never
# reaches the screen.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen.width = Window.GetWidth();
screen.height = Window.GetHeight();

field.image = Image("field.png");
field.error = Image("field-error.png");
lock.image = Image("lock.png");
lock.error = Image("lock-error.png");
bullet.image = Image("bullet.png");

pad = field.image.GetHeight() * 0.34;   # inner padding at both ends

# Vertical layout. Everything -- field, padlock, dots, spinner -- is placed
# relative to one "slot" the height of the field, so the spinner (shorter)
# sits where the field's centre was and nothing else moves when one replaces
# the other. Without a logo the slot is centred on the screen. With one, the
# logo, a gap and the slot are centred on the screen as a single block; the
# logo block below recomputes slot.y for that case. niri-splash lays its
# spinner out with the same slot height and gap, so the handoff holds still.
#
# Never write a block placeholder's name in a comment: package.nix inserts
# the block after every line that contains it, so the logo code once ran
# twice, the first time before slot.height existed.
slot.height = field.image.GetHeight();
slot.y = (screen.height - slot.height) / 2;

# Optional logo above the prompt, injected by package.nix when one is
# configured. Static: it neither pulses with the prompt nor changes on a
# rejected passphrase.
@LOGO@

slot.cy = slot.y + slot.height / 2;

field.x = (screen.width - field.image.GetWidth()) / 2;
field.y = slot.y;

field.sprite = Sprite(field.image);
field.sprite.SetX(field.x);
field.sprite.SetY(field.y);
field.sprite.SetZ(5);
field.sprite.SetOpacity(0);

lock.sprite = Sprite(lock.image);
lock.sprite.SetX(field.x + field.image.GetWidth() - pad - lock.image.GetWidth());
lock.sprite.SetY(slot.cy - lock.image.GetHeight() / 2);
lock.sprite.SetZ(10);
lock.sprite.SetOpacity(0);

bullet.spacing = bullet.image.GetWidth() * @BULLET_SPACING@;
bullet.x = field.x + pad;
bullet.y = slot.cy - bullet.image.GetHeight() / 2;

# Room for dots is the field minus: left padding, a gap before the padlock,
# the padlock itself, and its right padding.
bullet.room = field.image.GetWidth() - pad * 3 - lock.image.GetWidth();
bullet.max = (bullet.room + (bullet.spacing - bullet.image.GetWidth())) / bullet.spacing;

for (i = 0; i < bullet.max; i++) {
  bullets[i] = Sprite(bullet.image);
  bullets[i].SetX(bullet.x + i * bullet.spacing);
  bullets[i].SetY(bullet.y);
  bullets[i].SetZ(10);
  bullets[i].SetOpacity(0);
}

spinner.count = @SPINNER_COUNT@;
@SPINNER_FRAMES@

spinner.sprite = Sprite(spinner.frames[0]);
spinner.sprite.SetX((screen.width - spinner.frames[0].GetWidth()) / 2);
spinner.sprite.SetY(slot.cy - spinner.frames[0].GetHeight() / 2);
spinner.sprite.SetZ(5);
spinner.sprite.SetOpacity(0);

spinner.on = 0;
spinner.tick = 0;
spinner.index = 0;

# Plymouth gives no "wrong passphrase" callback, but its call sequence makes
# one unnecessary. Measured on this machine with an instrumented build:
# display_normal is called exactly once per submitted passphrase, and never at
# splash start. So display_normal *is* the submit signal, and a display_password
# that follows one can only be a re-prompt, which only happens on rejection.
# Backspacing to empty does not call display_normal, so it cannot be mistaken
# for a submission.
#
# Note the two flags are deliberately separate. state.submitted is cleared
# only by typing, never by time, so the rejection is detected no matter how
# long the check took. state.holding is the cosmetic part -- whether the field
# is still up -- and it does expire. Tying the two together is what broke the
# earlier versions: refresh() runs far faster here than the documented "up to
# 50 times a second" (nearer 180), so the grace elapsed before the rejection
# arrived and took the detection flag with it.
state.prompted = 0;    # a prompt has been shown at least once
# revealed/pending/reveal implement the hold-back below. The field is not
# drawn the moment a passphrase is asked for: on a machine that unlocks over
# the network (see modules/components/clevis-tang.nix) the request is
# answered from the other side a few seconds later, and a prompt that appears
# and vanishes on every boot reads as a fault. So the screen stays as it is
# and the field is drawn only once the reveal counter runs out -- or at once
# if a key is pressed, so the delay can never stop someone just typing.
# Once revealed it stays revealed for the rest of the boot, so a rejection
# re-prompt is immediate.
state.blanked = 0;     # composition abandoned after a mode change; latches
state.revealed = 0;    # field has been drawn; latches for the boot
state.pending = 0;     # a passphrase request is outstanding right now
state.reveal = @REVEAL_TICKS@;
state.submitted = 0;   # passphrase in flight; cleared by typing, not by time
state.holding = 0;     # field still on screen after a submission
state.wait = 0;
state.dots = 0;        # how many dots are currently lit, so the pulse knows
state.pulse = 0;       # triangle-wave counter driving the thinking pulse
state.dir = 1;

# The logo and spinner start hidden, so the screen is black until there is
# something to say. They come up together as "boot is progressing"
# (show_progress), the logo comes up alone above the field when a prompt is
# revealed (reveal_now), and both go for good on a mode change (blank_all).
# The body is injected by package.nix and is empty when the theme was built
# without a logo.
fun set_logo_opacity(o) {
  if (state.blanked == 0) {
@LOGO_OPACITY@
  }
}

fun show_spinner() {
  if (state.blanked == 0) {
    spinner.on = 1;
    spinner.sprite.SetOpacity(1);
  }
}

fun hide_spinner() {
  spinner.on = 0;
  spinner.sprite.SetOpacity(0);
}

# "Boot is progressing": logo and spinner together. Every path settles here
# once the disk is open, and showAtStart begins here.
fun show_progress() {
  set_logo_opacity(1);
  show_spinner();
}

# Called up to 50 times a second; advance one frame every @SPINNER_TICKS@th
# call. Frame count and tick divisor together set the cycle length, and both
# come from package.nix.
# Every sprite position in this theme is computed once, at script load, from
# the geometry Window.GetWidth()/GetHeight() reported then -- and Plymouth
# does not re-run the script when the framebuffer changes size. On a machine
# that hands off from the firmware's mode to a GPU driver's native one
# partway through boot (livingroompc goes to 4K when nvidia loads), every
# sprite is left at coordinates that were centred on a much smaller screen,
# so the whole composition jumps to the top-left at a fraction of the right
# size. The bitmaps cannot be rescaled at runtime -- Image.Scale() does not
# antialias, which is why they are rasterised at their final size to begin
# with -- so the logo and spinner leave the screen rather than sit there
# looking broken. A passphrase field, if one is up, stays: see blank_all. It
# latches: the display manager is a second or two behind the mode change, and
# a black gap there reads as nothing at all.
fun reveal_now() {
  state.revealed = 1;
  hide_spinner();
  set_logo_opacity(1);
  show_dots(state.dots);
  set_prompt_opacity(1);
}

# The hold-back is measured in seconds, not in refresh() calls. refresh() is
# called at whatever rate Plymouth feels like: measured at ~75/sec on
# livingroompc while the spinner was animating and ~37/sec once it was not,
# so a tick count is not a unit of time and cannot be tuned into one.
# SetBootProgressFunction hands over the elapsed seconds since boot began,
# which is an actual clock.
#
# The tick counter in refresh() survives as a backstop for the case where
# boot progress never arrives at all -- without it, a theme that only reveals
# on a callback that never fires would leave someone at a black screen with
# no way to know a passphrase was wanted. Set it far longer than the seconds
# threshold so it only ever fires when the clock did not.
fun boot_progress(duration, progress) {
  if (state.pending) {
    if (state.revealed == 0) {
      if (duration >= @REVEAL_SECONDS@) {
        reveal_now();
      }
    }
  }
}

fun blank_all() {
  hide_spinner();
  set_logo_opacity(0);
  # Latched last, because set_logo_opacity is a no-op once blanked. The field
  # and dots are deliberately left alone: after the mode change they sit
  # off-center and undersized, but a prompt you can see beats typing blind.
  state.blanked = 1;
}

fun refresh() {
  if (state.blanked == 0) {
    if (Window.GetWidth() != screen.width) {
      blank_all();
    } else {
      if (Window.GetHeight() != screen.height) {
        blank_all();
      }
    }
  }

  # Hold-back countdown. Runs only while a request is actually outstanding,
  # so an unlock from elsewhere stops it (display_normal clears pending)
  # rather than revealing an empty field seconds after boot moved on.
  if (state.pending) {
    if (state.revealed == 0) {
      state.reveal = state.reveal - 1;
      if (state.reveal <= 0) {
        reveal_now();
      }
    }
  }

  # Held field after a submission: if nothing has asked us again by now, the
  # passphrase was accepted and boot is carrying on.
  if (state.holding) {
    state.wait = state.wait - 1;

    # Triangle wave rather than a sine: no trig in this language, and a linear
    # ramp is indistinguishable at this speed.
    state.pulse = state.pulse + state.dir;
    if (state.pulse >= @PULSE_STEPS@) {
      state.pulse = @PULSE_STEPS@;
      state.dir = 0 - 1;
    }
    if (state.pulse <= 0) {
      state.pulse = 0;
      state.dir = 1;
    }
    set_prompt_opacity(@PULSE_MIN@ + (1.0 - @PULSE_MIN@) * state.pulse / @PULSE_STEPS@);

    if (state.wait <= 0) {
      state.holding = 0;
      hide_field();
      show_dots(0);
      show_progress();
    }
  }

  if (spinner.on) {
    spinner.tick = spinner.tick + 1;
    if (spinner.tick >= @SPINNER_TICKS@) {
      spinner.tick = 0;
      spinner.index = spinner.index + 1;
      if (spinner.index >= spinner.count) {
        spinner.index = 0;
      }
      spinner.sprite.SetImage(spinner.frames[spinner.index]);
    }
  }
}

fun hide_field() {
  state.dots = 0;
  field.sprite.SetOpacity(0);
  lock.sprite.SetOpacity(0);
  field.sprite.SetImage(field.image);
  lock.sprite.SetImage(lock.image);
}

# Fade the whole prompt together: border, padlock and the lit dots. Only the
# dots that are actually shown are touched, so the unused ones stay hidden.
fun set_prompt_opacity(o) {
  field.sprite.SetOpacity(o);
  lock.sprite.SetOpacity(o);
  for (i = 0; i < bullet.max; i++) {
    if (i < state.dots) {
      bullets[i].SetOpacity(o);
    }
  }
}

fun show_dots(n) {
  for (i = 0; i < bullet.max; i++) {
    if (i < n) {
      bullets[i].SetOpacity(1);
    } else {
      bullets[i].SetOpacity(0);
    }
  }
}

fun display_password(prompt, count) {
  state.prompted = 1;
  state.pending = 1;

  # Typing always wins over the hold-back.
  if (state.revealed == 0) {
    if (count > 0) {
      state.revealed = 1;
    }
  }

  if (state.revealed == 0) {
    # Still held: remember what was typed, change nothing on screen.
    state.dots = count;
  } else {
    # Same picture as reveal_now(), which this path skips when a keypress
    # ends the hold-back: logo above the field, spinner gone.
    hide_spinner();
    set_logo_opacity(1);

    # Being asked again while a submission was in flight means it was
    # rejected.
    if (state.submitted) {
      state.submitted = 0;
      state.holding = 0;
      field.sprite.SetImage(field.error);
      lock.sprite.SetImage(lock.error);
    }

    # Typing clears the rejection.
    if (count > 0) {
      field.sprite.SetImage(field.image);
      lock.sprite.SetImage(lock.image);
    }

    state.dots = count;
    show_dots(count);
    set_prompt_opacity(1);
  }
}

fun display_normal() {
  state.pending = 0;

  if (state.revealed == 0) {
    # Answered from elsewhere before the field was ever drawn -- nothing to
    # hold and nothing to fade. Straight to progress. Clearing pending above
    # also stops the reveal countdown, so the field cannot surface after
    # boot has moved on.
    hide_field();
    show_dots(0);
    show_progress();
  } else {
    if (state.prompted) {
      # A passphrase was just submitted. Hold the field, minus its dots,
      # rather than cutting to the spinner: a rejection comes back within
      # about a second, and a spinner that appears and vanishes reads as a
      # glitch. If no rejection arrives, refresh() gives up after the grace
      # and shows progress, which is the accepted-passphrase path. The unlock
      # status usually beats it there: see unlock_observed.
      state.submitted = 1;
      state.holding = 1;
      state.wait = @VERIFY_GRACE@;

      # Leave the dots exactly as typed. They stay until the answer arrives:
      # cleared by the red on rejection, or hidden with the field on success.
      state.pulse = @PULSE_STEPS@;
      state.dir = 0 - 1;
      set_prompt_opacity(1);
    } else {
      hide_field();
      show_dots(0);
      show_progress();
    }
  }
}

# Plymouth has no "the passphrase was answered by something else" callback,
# and display_normal measurably does not fire on that path: when clevis
# unlocks the disk over the network the password callbacks simply stop. So
# the initrd says it outright. modules/components/plymouth.nix orders a
# oneshot after every systemd-cryptsetup@ unit that runs
# `plymouth update --status=luks-unlocked`, which lands in update_status()
# a moment after the volume opens.
#
# It also ends the post-submission hold on a typed passphrase early. That
# grace only exists because a rejection has to be inferred, and an open disk
# settles the question.
#
# Root being mounted stays wired as a backstop. Under the systemd initrd it
# does fire, but only from plymouth-switch-root.service right before
# switch-root, which is too late to be the main signal.
fun unlock_observed() {
  state.pending = 0;
  state.holding = 0;
  state.submitted = 0;
  hide_field();
  show_dots(0);
  show_progress();
}

# The status string is shared with modules/components/plymouth.nix. Any other
# status (nothing else on this fleet sends one) is ignored.
fun update_status(status) {
  if (status == "luks-unlocked") {
    unlock_observed();
  }
}

Plymouth.SetUpdateStatusFunction(update_status);
Plymouth.SetRootMountedFunction(unlock_observed);
Plymouth.SetBootProgressFunction(boot_progress);

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayQuestionFunction(fun (prompt, entry) { display_normal(); });
Plymouth.SetMessageFunction(fun (text) { });

# Logo and spinner from the moment the splash comes up (showAtStart). Right
# for a machine that unlocks with nothing to ask, such as TPM2: there is
# nothing to wait on, so the screen may as well say boot is under way. If the
# unlock fails and a passphrase is asked for after all, reveal_now() swaps the
# spinner for the field under the same logo.
#
# Everything else starts black. A machine that always prompts goes straight to
# the field. One that unlocks over the network stays black through the
# hold-back until either the disk opens (unlock_observed) or the field is due.
if (@SHOW_AT_START@ > 0) {
  show_progress();
}
