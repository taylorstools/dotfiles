[[ $- != *i* ]] && return
case $- in
	*i*) ;;
	*) return ;;
esac

# Binds
bind '"\C-a": unix-line-discard'

# ===== ALIASES =====
alias grep='grep --color=auto'
alias cls='clear'
alias ls='exa -a --icons --color=always --group-directories-first'
alias ll='exa -alF --icons --color=always --group-directories-first'

# Update NixOS flake and rebuild system
if [ -f /etc/os-release ] && grep -q '^ID=nixos' /etc/os-release; then
  alias update='git -C $HOME/.dotfiles pull --rebase --autostash && git -C $HOME/.dotfiles add --intent-to-add nixos/hosts/$(hostname)/hardware-configuration.nix 2>/dev/null; nix flake update --flake $HOME/.dotfiles/nixos && sudo nixos-rebuild switch --flake $HOME/.dotfiles/nixos#$(hostname)'
fi

# git push script
push() {
  if [ -z "$1" ]; then
    echo "Usage: push \"commit message\""
    return 1
  fi
  git add . && git commit -m "$1" && git push
}

# Prompt
PS1='\[\033[36m\]\w > \[\033[0m\]'

export XDG_CONFIG_HOME="$HOME/.config"

export SCM_CHECK=true

fastfetch --logo-type small
eval "$(zoxide init --cmd cd bash)"