 <stuff category="108">
  <name>Linux Distro Logos [colored and circled] - macOS Style</name>
  <providerid>api.kde-look.org</providerid>
  <author>tobilinuxer</author>
  <homepage>https://store.kde.org/p/2106821</homepage>
  <licence></licence>
  <version>v1.0</version>
