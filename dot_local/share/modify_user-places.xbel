#!/usr/bin/env python3
"""Ensure tracked Dolphin Places entries exist; strip device-anchored separators."""
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

HOME = str(Path.home())

TRACKED = [
    {"href": f"file://{HOME}/.dotfiles",            "title": ".dotfiles", "icon": "inode-directory"},
    {"href": f"file://{HOME}/.dotfiles/dot_config", "title": ".config",   "icon": "inode-directory"},
    {"href": f"file://{HOME}/.dotfiles/nixos",      "title": "nixos",     "icon": "inode-directory"},
    {"href": "smb://192.168.0.63/TaylorNAS",          "title": "TaylorNAS", "icon": "network-workgroup"},
    {"href": "smb://192.168.0.63/TaylorNAS/jellyfin", "title": "jellyfin",  "icon": "network-workgroup"},
]

FDO = "http://freedesktop.org"
BOOKMARK_NS = "http://www.freedesktop.org/standards/desktop-bookmarks"
ET.register_namespace("bookmark", BOOKMARK_NS)
ET.register_namespace("kdepriv", "http://www.kde.org/kdepriv")
ET.register_namespace("mime", "http://www.freedesktop.org/standards/shared-mime-info")

raw = sys.stdin.read().strip() or (
    '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE xbel>\n'
    '<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks"'
    ' xmlns:kdepriv="http://www.kde.org/kdepriv"'
    ' xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info"></xbel>'
)
root = ET.fromstring(raw)
existing = {b.get("href") for b in root.findall("bookmark")}

# Drop separators anchored to a specific block device
for sep in list(root.findall("separator")):
    if sep.find(".//UDI") is not None:
        root.remove(sep)

def make_bookmark(href, title, icon):
    bm = ET.Element("bookmark", {"href": href})
    ET.SubElement(bm, "title").text = title
    info = ET.SubElement(bm, "info")
    md = ET.SubElement(info, "metadata", {"owner": FDO})
    ET.SubElement(md, f"{{{BOOKMARK_NS}}}icon", {"name": icon})
    return bm

for spec in TRACKED:
    if spec["href"] not in existing:
        root.append(make_bookmark(**spec))

sys.stdout.write('<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE xbel>\n')
sys.stdout.write(ET.tostring(root, encoding="unicode"))