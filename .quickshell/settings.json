{
    "animationDuration": 50,
    "attachPanels": true,
    "attachedPanelBorder": false,
    "barZoomsWithOverview": true,
    "blur": true,
    "blurStrength": 100,
    "blurXray": true,
    "borderColor": "primary",
    "borderColorCustom": "#ffffff",
    "borderOpacity": 0.5,
    "clipboardClearOnStartup": true,
    "clipboardClearPinned": true,
    "colorfulSeed": false,
    "dockAutoHide": true,
    "dockBorder": false,
    "dockEnabled": true,
    "dockIconSize": 30,
    "dockPins": [
        "thunar",
        "org.kde.krdc",
        "com.mitchellh.ghostty",
        "com.anthropic.Claude",
        "codium",
        "md.obsidian.Obsidian",
        "davinci-resolve-studio",
        "firefox",
        "google-chrome"
    ],
    "dockPosition": "left",
    "dockSpacing": 8,
    "flyoutRadius": 12,
    "fontFamily": "Inter",
    "fontWeight": "medium",
    "keyPressEntries": [
        {
            "cmd": "qs ipc call runner toggle",
            "desc": "Run",
            "key": "r"
        },
        {
            "cmd": "ghostty -e sudo -i",
            "desc": "Terminal (Root)",
            "key": "t"
        },
        {
            "cmd": "sudo -EH thunar",
            "desc": "File Explorer (Root)",
            "key": "e"
        },
        {
            "cmd": "missioncenter",
            "desc": "Task Manager",
            "key": "m"
        },
        {
            "cmd": "sudo -EH gparted",
            "desc": "Disk Management",
            "key": "k"
        },
        {
            "cmd": "qs ipc call snip open",
            "desc": "Snipping Tool",
            "key": "s"
        },
        {
            "cmd": "$HOME/scripts/ocr-snip.sh",
            "desc": "OCR Select and Copy",
            "key": "o"
        },
        {
            "cmd": "qs ipc call night toggle",
            "desc": "Toggle Night Mode",
            "key": "b"
        },
        {
            "cmd": "qs ipc call nightpanel toggle",
            "desc": "Night Mode Strength",
            "key": "n"
        },
        {
            "cmd": "$HOME/scripts/hypridle/toggle-hypridle.sh",
            "desc": "Toggle Keep Awake",
            "key": "a"
        },
        {
            "cmd": "qs ipc call wallpaper random",
            "desc": "Change Wallpaper",
            "key": "w"
        },
        {
            "cmd": "$HOME/scripts/niri_change-refresh-rate.sh",
            "desc": "Change Refresh Rate",
            "key": "d"
        },
        {
            "cmd": "whisrs toggle",
            "desc": "Toggle Voice-to-Text",
            "key": "y"
        },
        {
            "cmd": "qs ipc call powermenu toggle",
            "desc": "Power",
            "key": "p"
        }
    ],
    "lockCommand": "$HOME/scripts/hypridle/lock-session.sh --force",
    "logoutCommand": "niri msg action quit --skip-confirmation",
    "matugenScheme": "scheme-neutral",
    "monoFontFamily": "JetBrainsMono Nerd Font Mono",
    "notificationPosition": "bottom-right",
    "overlayOpacity": 0.5,
    "powerMenuShowLock": true,
    "powerMenuShowLogout": true,
    "powerMenuShowReboot": true,
    "powerMenuShowShutdown": true,
    "powerMenuShowSleep": true,
    "powerMenuShowWindows": true,
    "restartCommand": "systemctl reboot",
    "runningAppsCurrentWorkspaceOnly": false,
    "runningAppsFullTitleWidth": 120,
    "runningAppsGroupByApp": false,
    "runningAppsLargeIcons": true,
    "runningAppsMaxWidth": 0,
    "runningAppsMaxWidthPercent": 100,
    "runningAppsMinTitleWidth": 32,
    "runningAppsReservedWidth": 300,
    "shutdownCommand": "systemctl poweroff",
    "sleepCommand": "$HOME/scripts/hypridle/lock-session.sh & sleep 1; systemctl suspend",
    "surfaceOpacity": 0.8,
    "surfaceTint": 0.5,
    "surfaceTintColor": "custom",
    "surfaceTintCustom": "#000000",
    "wallpaperAutoChange": true,
    "wallpaperChangeAtStartup": true,
    "wallpaperChangeInterval": 15,
    "wallpaperFadeDuration": 500,
    "wallpaperFolder": "/home/taylor/.dotfiles/Wallpapers",
    "windowsCommand": "$HOME/scripts/refind_boot-to-windows.sh"
}
