{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Blue is the terminal palette's wallpaper colour (bright blue a lighter
  // shade). The logo's default cyan is a fixed hue in term16.py, so it barely
  // changes between wallpapers.
  "logo": {
    "color": {
      "1": "blue",
      "2": "light_blue",
      "3": "blue",
      "4": "light_blue",
      "5": "blue",
      "6": "light_blue"
    }
  },
  "display": {
    "color": {
      "keys": "blue",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "wm",
    "host",
    "packages",
    "cpu",
    "gpu",
    "display",
    "memory",
    "zpool",
    "uptime",
    "break",
  ]
}
