{
    "label" : "lock",
    "action" : "$HOME/scripts/hypridle/lock-session.sh --force",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "niri msg action quit --skip-confirmation",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "sleep",
    "action" : "$HOME/scripts/hypridle/lock-session.sh & sleep 1; systemctl suspend",
    "text" : "Sleep",
    "keybind" : "z"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "windows",
    "action" : "$HOME/scripts/refind_boot-to-windows.sh",
    "text" : "Windows",
    "keybind" : "w"
}
