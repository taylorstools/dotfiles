// Colours from the wallpaper, written by the shell (Theming/generate.sh).
// optional until it first runs.
include "colors.kdl" optional=true
// Blur strength (and the settings window's blur rule) from the shell's
// settings window, Appearance page. optional until the shell first writes it.
include "~/.local/state/qstest/niri-blur.kdl" optional=true

// Include custom configs
include "custom/animations.kdl"
include "custom/binds.kdl"
include "custom/input.kdl"
include "custom/layout.kdl"
include "custom/misc.kdl"
include "custom/rules.kdl"
include "custom/startup.kdl"
include "custom/cursor.kdl"

// Cursor override for the startup splash. Last on purpose: includes are
// positional, and this has to override custom/cursor.kdl. niri-splash writes
// the transparent theme into it at logout so the next login starts with no
// visible cursor, and puts it back the moment the splash lifts. At rest the
// file is a single comment. optional=true so a missing file is a warning,
// not a broken config. See myOptions.niri-splash.blankCursorAtBoot.
include "custom/cursor-startup.kdl" optional=true
