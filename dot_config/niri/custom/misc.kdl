environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORM "wayland"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORMTHEME "gtk3"
  QT_QPA_PLATFORMTHEME_QT6 "gtk3"
}

overview {
    // Also what is on screen before swaybg has painted anything: with
    // layout background-color "transparent" and the wallpaper placed within
    // the backdrop, the backdrop is the bottom of the stack at all times,
    // not only in the overview. niri's default here is a mid-grey, which is
    // the grey flash at login. Black matches plymouth and the splash, and is
    // invisible in the overview itself because the wallpaper covers it.
    backdrop-color "#000000"

    workspace-shadow {
        off
    }
}

gestures {
    hot-corners {
        bottom-left
    }
}

output "eDP-1" {
    scale 1.875
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
  
switch-events {
    lid-close {
        spawn "sh" "-c" "$HOME/scripts/hypridle/save-kbd-brightness-and-dim.sh; pidof hyprlock || (hyprlock -q & sleep 1) && systemctl suspend"
    }
    lid-open {
        spawn "sh" "-c" "$HOME/scripts/hypridle/restore-kbd-brightness.sh"
    }
}

hotkey-overlay {
    skip-at-startup
}

debug {
    honor-xdg-activation-with-invalid-serial
}

screenshot-path "/tmp/screenshot.png"