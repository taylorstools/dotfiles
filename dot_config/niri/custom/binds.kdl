binds {
    // Apps
    Mod+T               { spawn "ghostty"; }
    Mod+E               { spawn "thunar"; }
    Mod+B               { spawn "google-chrome-stable"; }
    Ctrl+Shift+Escape   { spawn "missioncenter"; }

    // Run apps as root
    Mod+Shift+E { spawn  "sh" "-c" "sudo -EH thunar"; }
    Mod+Shift+T { spawn "ghostty" "-e" "sudo" "-i"; }

    // Screenshot
    Print       { spawn "sh" "-c" "$HOME/scripts/snipping-tool.sh"; }
    Ctrl+Print  { spawn "sh" "-c" "$HOME/scripts/snipping-tool.sh --region"; }
    Mod+Shift+O { spawn "sh" "-c" "$HOME/scripts/ocr-snip.sh"; }

    // Dictation. whisrs fires its own hook into the shell's pill, so these
    // call it directly - and Super+Shift+V from its [hotkeys] does the same.
    Mod+Y       { spawn "whisrs" "toggle"; }
    Mod+Shift+Y { spawn "whisrs" "cancel"; }

    // Niri related
    Mod+Q       { close-window; }
    Mod+Up      { spawn "sh" "-c" "niri msg action reset-window-height; niri msg action maximize-window-to-edges"; }
    Mod+Return  { spawn "sh" "-c" "niri msg action reset-window-height; niri msg action maximize-window-to-edges"; }
    Mod+F       { spawn "sh" "-c" "$HOME/scripts/niri_toggle-floating.sh"; }

    // Navigation
    Mod+Left        { focus-column-left; }
    Mod+Right       { focus-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-to-workspace-up; }
    Mod+Shift+Down  { move-window-to-workspace-down; }

    // Resize window height
    //Mod+Shift+Up    { set-window-height "50%"; }
    //Mod+Shift+Down  { set-window-height "100%"; }

    // Workspaces
    Mod+Prior   { focus-workspace-up; }
    Mod+Next    { focus-workspace-down; }
    Mod+1       { focus-workspace 1; }
    Mod+2       { focus-workspace 2; }
    Mod+3       { focus-workspace 3; }
    Mod+4       { focus-workspace 4; }
    Mod+5       { focus-workspace 5; }
    Mod+6       { focus-workspace 6; }
    Mod+7       { focus-workspace 7; }
    Mod+8       { focus-workspace 8; }
    Mod+9       { focus-workspace 9; }

    // Shell (the Quickshell config in ~/.dotfiles/.quickshell)
    Mod+D   { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+V   { spawn "qs" "ipc" "call" "clipboard" "toggle"; }
    Mod+N   { spawn "qs" "ipc" "call" "notepad" "toggle"; }

    // Overview
    Mod+Space   { toggle-overview; }

    // Runner
    Mod+R   { spawn "qs" "ipc" "call" "runner" "toggle"; }

    // Window switcher
    Mod+Tab { spawn "qs" "ipc" "call" "switcher" "toggle"; }

    // Lock screen
    // --force: a keybind can only reach niri while the session is unlocked, so
    // any hyprlock still alive here is a leftover that failed to exit.
    Mod+L   { spawn "sh" "-c" "$HOME/scripts/hypridle/lock-session.sh --force"; }

    // Toggle keep awake on/off
    Mod+K   { spawn "sh" "-c" "$HOME/scripts/hypridle/toggle-hypridle.sh"; }

    // Wlogout
    Ctrl+Alt+Delete { spawn "qs" "ipc" "call" "powermenu" "toggle"; }

    // Change wallpaper
    Mod+Shift+W { spawn "qs" "ipc" "call" "wallpaper" "random"; }

    // Toggle night light
    Mod+Shift+B { spawn "qs" "ipc" "call" "night" "toggle"; }

    // Color picker
    Mod+C   { spawn "sh" "-c" "$HOME/scripts/pick-color.sh"; }

    // Secondary menu
    Mod+X   { spawn "sh" "-c" "pkill wlr-which-key || wlr-which-key"; }

    // Change display refresh rate and scale
    Mod+Shift+R { spawn "sh" "-c" "$HOME/scripts/niri_change-refresh-rate.sh"; }
    Mod+Minus   { spawn "sh" "-c" "$HOME/scripts/niri_change-screen-scale.sh --decrease"; }
    Mod+Equal   { spawn "sh" "-c" "$HOME/scripts/niri_change-screen-scale.sh --increase"; }

    // Claude
    Mod+Shift+F23 { spawn "claude-desktop"; } // Copilot key

    // Laptop specific keybinds
    xf86MonBrightnessDown   { spawn "qs" "ipc" "call" "brightness" "decrement" "5"; }
    xf86MonBrightnessUp     { spawn "qs" "ipc" "call" "brightness" "increment" "5"; }

    XF86KbdLightOnOff       { spawn "sh" "-c" "$HOME/scripts/kbd-backlight.sh"; }

    XF86AudioLowerVolume    { spawn "qs" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioRaiseVolume    { spawn "qs" "ipc" "call" "audio" "increment" "5"; }

    XF86AudioMute           { spawn "qs" "ipc" "call" "audio" "mute"; }

    XF86AudioMicMute        { spawn "qs" "ipc" "call" "audio" "micmute"; }
}
