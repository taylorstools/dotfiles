// NO LONGER NEEDED. Startup now autologins into
// niri after prompting for LUKS password

// hyprlock
//spawn-sh-at-startup "(pidof hyprlock || hyprlock -q) || niri msg action quit --skip-confirmation"

// hyprlock first key press fix
//spawn-sh-at-startup "$HOME/scripts/send-keypress-at-startup.sh"

// hypridle
spawn-sh-at-startup "pidof hypridle || hypridle &"

// swaybg, held until the startup splash is covering the screen so the
// wallpaper is never seen being painted. No-ops where niri-splash is not
// installed. See myOptions.niri-splash.
spawn-sh-at-startup "$HOME/scripts/niri_set-wallpaper.sh --at-login &"

// Script that makes background image for hyprlock and wlogout
spawn-sh-at-startup "$HOME/scripts/niri_make-effects-wallpaper.sh"

// libinput-gestures
spawn-sh-at-startup "systemctl --user start libinput-gestures &"